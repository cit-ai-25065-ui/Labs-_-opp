#include <iostream>
using namespace std;

struct FeetInches {
    int feet;
};

struct RoomDimension {
    FeetInches length;
    FeetInches width;
};

int computeTheCarpetingCost(const RoomDimension& room) {
    int area = room.length.feet * room.width.feet;
    return area * 18;
}

int main() {
    int numRooms;
    cin >> numRooms;

    RoomDimension* rooms = new RoomDimension[numRooms];

    for (int i = 0; i < numRooms; i++) {
        cin >> rooms[i].length.feet;
        cin >> rooms[i].width.feet;
    }

    int choice;
    do {
        cout << "1. Total Cost\n2. Room Cost\n3. Exit\nChoice: ";
        cin >> choice;

        if (choice == 1) {
            int totalCost = 0;
            for (int i = 0; i < numRooms; i++) {
                totalCost += computeTheCarpetingCost(rooms[i]);
            }
            cout << "Total Cost: " << totalCost << " Rs\n";
        } 
        else if (choice == 2) {
            for (int i = 0; i < numRooms; i++) {
                cout << "Room " << (i + 1) << ": " << computeTheCarpetingCost(rooms[i]) << " Rs\n";
            }
        }
    } while (choice != 3);

    delete[] rooms;
    return 0;
}
