#include <iostream>
#include <string>
#include <cctype>
#include <iomanip>

using namespace std;

struct InventoryItem {
    string itemCode;
    string itemName;
    double cost;
    double sellingPrice;
};

int counter = 31203;

InventoryItem insertItem() {
    InventoryItem item;
    
    cin >> item.itemName;
    cin >> item.cost;
    
    item.sellingPrice = item.cost + (item.cost * 0.40);
    
    string prefix = "";
    for (int i = 0; i < 3 && i < item.itemName.length(); i++) {
        prefix += toupper(item.itemName[i]);
    }
    
    item.itemCode = prefix + "_" + to_string(counter++);
    
    return item;
}

void displayStock(const InventoryItem* items) {
    cout << left << setw(15) << "Item Code" 
         << setw(15) << "Item Name" 
         << setw(12) << "Cost" 
         << setw(15) << "Selling Price" << endl;
    
    for (int i = 0; i < 10; i++) {
        cout << left << setw(15) << items[i].itemCode 
             << setw(15) << items[i].itemName 
             << setw(12) << items[i].cost 
             << setw(15) << items[i].sellingPrice << endl;
    }
}

int main() {
    InventoryItem inventory[10];

    for (int i = 0; i < 10; i++) {
        inventory[i] = insertItem();
    }

    displayStock(inventory);

    return 0;
}

