#include <iostream>
#include <cstring>
using namespace std;

int main() {
    char str[30];
    int count;

    cout << "Enter a string (max 29 chars): ";
    cin >> str;

    cout << "Enter count of letters to display: ";
    cin >> count;

    int length = strlen(str);

    // التحقق من أن العدد المطلوب ضمن نطاق طول النص
    if (count < 0 || count > length) {
        cout << "Error: Out of range count!" << endl;
    } else {
        cout << "Substring: ";
        for (int i = 0; i < count; i++) {
            cout << str[i];
        }
        cout << endl;
    }

    return 0;
}
