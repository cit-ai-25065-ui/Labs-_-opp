#include <iostream>
using namespace std;

int main() {
    int n;
    cout << "Enter the dimension of square matrix (n x n): ";
    cin >> n;

    int** matrix = new int*[n];
    for (int i = 0; i < n; i++) {
        matrix[i] = new int[n];
    }

    cout << "Enter the elements of the matrix:\n";
    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++) {
            cin >> matrix[i][j];
        }
    }

    bool isDiagonal = true;
    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++) {
            // العناصر خارج القطر الرئيسي يجب أن تكون 0
            if (i != j && matrix[i][j] != 0) {
                isDiagonal = false;
                break;
            }
        }
    }

    if (isDiagonal) {
        cout << "The matrix is a diagonal matrix." << endl;
    } else {
        cout << "The matrix is NOT a diagonal matrix." << endl;
    }

    // تحرير الذاكرة
    for (int i = 0; i < n; i++) {
        delete[] matrix[i];
    }
    delete[] matrix;

    return 0;
}

